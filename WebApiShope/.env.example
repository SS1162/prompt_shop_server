# Copy this file to .env and fill in the real values.
# .env is listed in .gitignore and .dockerignore so secrets never enter version
# control or Docker image layers.

# ── SQL Server ────────────────────────────────────────────────────────────────
# Must satisfy MSSQL password policy: ≥8 chars, upper, lower, digit, symbol
SA_PASSWORD=YourStrong!Passw0rd

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=YourStrongRedis!Passw0rd

# ── Gemini AI API ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── PayPal (sandbox) ──────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ── Admin seed account ────────────────────────────────────────────────────────
ADMIN_NAME=admin@example.com
ADMIN_PASSWORD=Admin@123%
